<configuration>
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/${cargo.context:-cargo}.log</file>
        <encoder><pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{25} - %msg%n</pattern></encoder>
    </appender>
    <logger name="org.eclipse.californium" level="OFF"/>
    <root level="INFO"><appender-ref ref="FILE"/></root>
</configuration>
